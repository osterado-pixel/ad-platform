# Локальный запуск без Docker. Скопируйте в backend/.env (start.ps1 сделает это сам).

# Обязательно, не короче 32 символов. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# По умолчанию — SQLite-файл backend/app.db. Для PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ad_db

# Домены отдельного фронтенда (React/Vue/Next.js), которым можно обращаться к API, через запятую.
# По умолчанию — локальные серверы разработки: localhost/127.0.0.1 на портах 3000, 5173, 8080.
# Виджет на сайтах-партнёрах работает независимо от этой настройки
# CORS_ORIGINS=https://app.example.com

# Домены, по которым открывают платформу (защита от подмены Host). По умолчанию * — любые
# ALLOWED_HOSTS=ads.example.com

# Повторный клик с того же IP по той же кампании в течение N минут не оплачивается
# CLICK_DEDUP_MINUTES=10

# Стоимость хеширования паролей bcrypt (12 — норма; меньше — быстрее, но слабее)
# BCRYPT_ROUNDS=12
