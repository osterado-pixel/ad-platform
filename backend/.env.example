# Локальный запуск без Docker. Скопируйте в backend/.env (start.ps1 сделает это сам).

# --- База данных PostgreSQL (для запуска в Docker с PostgreSQL) ---
# Приложение берёт адрес базы только из DATABASE_URL (ниже); POSTGRES_* — для контейнера базы.
# Пароль — случайный: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ad_platform_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Настройки FastAPI / JWT ---
# Обязательно, не короче 32 символов, случайный (НЕ пример из инструкций). Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_ALGORITHM=HS256
# Срок действия токена входа, минут
ACCESS_TOKEN_EXPIRE_MINUTES=60

# По умолчанию — SQLite-файл backend/app.db. Для PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ad_db

# Домены отдельного фронтенда (React/Vue/Next.js), которым можно обращаться к API, через запятую.
# По умолчанию — локальные серверы разработки: localhost/127.0.0.1 на портах 3000, 5173, 8080.
# Виджет на сайтах-партнёрах работает независимо от этой настройки
# CORS_ORIGINS=https://app.example.com

# Домены, по которым открывают платформу (защита от подмены Host). По умолчанию * — любые
# ALLOWED_HOSTS=ads.example.com

# Повторный клик с того же IP по той же кампании в течение N минут не оплачивается
# CLICK_DEDUP_MINUTES=10

# Стоимость хеширования паролей bcrypt (12 — норма; меньше — быстрее, но слабее)
# BCRYPT_ROUNDS=12

# --- AI-проверка объявлений (Claude) ---
# Ключ Anthropic API (console.anthropic.com). Не задан — AI-проверка выключена, модерация ручная
# ANTHROPIC_API_KEY=
# Модель (по умолчанию claude-opus-5-5)
# AI_MODEL=claude-opus-5-5
# Автоматически отклонять явные нарушения (verdict=reject, risk=high). По умолчанию — только подсказка
# AI_AUTO_REJECT=false
# Ключ Google Gemini API (бесплатно: aistudio.google.com/apikey)
# GEMINI_API_KEY=
# Модель AI-копирайтера (по умолчанию gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
# Курс: сколько единиц валюты баланса стоит 1 $ (баланс в рублях — например 90)
# USD_RATE=1
# Наценка платформы к себестоимости AI-запроса
# AI_MARKUP=1.5
# Цены модели, $ за 1 млн токенов (ai.google.dev/gemini-api/docs/pricing); с 01.01.2027 у 3.8 Flash — 1.50 / 7.50
# GEMINI_PRICE_INPUT_PER_1M=0.75
# GEMINI_PRICE_OUTPUT_PER_1M=3.75
# Ключ OpenAI для бесплатного Moderation API (platform.openai.com/api-keys). Не задан — только локальный фильтр
# OPENAI_API_KEY=
