# Что не копировать в образ (COPY . .)

# Кеш Python. "**/" обязателен: в .dockerignore, в отличие от .gitignore, шаблон без него
# срабатывает только в корне, и app/__pycache__ попал бы в образ
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache

# Виртуальные окружения
.venv
venv

# Базы данных SQLite, их служебные файлы и резервные копии — в образе им не место
*.db
*.sqlite3
*.db-wal
*.db-shm
*.db.bak-*
backups

# Секреты: передаются переменными окружения (docker-compose.yml), а не файлом в образе
.env

# Git и тесты — в работающем контейнере не нужны
.git
.gitignore
tests
