# HTTPS-прокси перед платформой. Сертификат Let's Encrypt Caddy получает и продлевает сам —
# нужно, чтобы DNS-запись домена указывала на сервер и были открыты порты 80 и 443.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Caddy сам передаёт X-Forwarded-For / X-Forwarded-Proto: платформа видит реальный IP
	# посетителя (защита от повторных кликов) и что запрос пришёл по HTTPS (HSTS, ссылки https)
	reverse_proxy api:8000

	# Не раскрывать, какой сервер стоит за доменом
	header -Server
}
