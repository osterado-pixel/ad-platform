# Настройки для docker compose. Скопируйте в .env (рядом с docker-compose.yml) и заполните.
# Сгенерировать значения:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Пароль PostgreSQL (только латиница, цифры, - и _ — он вставляется в адрес подключения)
POSTGRES_PASSWORD=

# Ключ подписи токенов входа, не короче 32 символов. Смена ключа разлогинит всех
SECRET_KEY=

# Порт на этой машине, на котором будет доступна платформа
API_PORT=8000

# Число процессов сервера (для PostgreSQL можно 2–4 на ядро)
WEB_WORKERS=2

# Домены отдельного фронтенда (React/Vue/Next.js), которым можно обращаться к API, через запятую:
# CORS_ORIGINS=https://app.example.com
# Пусто — только встроенный интерфейс /app. Виджет на сайтах-партнёрах работает в любом случае
CORS_ORIGINS=

# Домены, по которым открывают платформу (защита от подмены заголовка Host), через запятую.
# Например: ads.example.com. * — любые
ALLOWED_HOSTS=*

# Если перед платформой стоит nginx/балансировщик — его IP (или * во внутренней сети),
# чтобы учитывался реальный IP посетителя. Без прокси оставьте 127.0.0.1
FORWARDED_ALLOW_IPS=127.0.0.1

# Повторный клик с того же IP по той же кампании в течение N минут не оплачивается
CLICK_DEDUP_MINUTES=10
