# ==============================================================================
# НАСТРОЙКИ ДЛЯ DOCKER COMPOSE (.env.example)
# Скопируйте в .env рядом с docker-compose.prod.yml (или docker-compose.yml) и заполните:
#   cp .env.example .env
# НЕ добавляйте .env в git: в нём пароли и ключи (.env уже в .gitignore).
# Сгенерировать надёжное значение:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Строки с # — значения по умолчанию: раскомментируйте, только если нужно другое.
# ==============================================================================

# ------------------------------------------------------------------------------
# ПРИЛОЖЕНИЕ
# ------------------------------------------------------------------------------
# Порт на этой машине, на котором будет доступна платформа (без HTTPS-надстройки)
API_PORT=8000

# Число процессов веб-сервера (для PostgreSQL можно 2–4 на ядро)
WEB_WORKERS=2

# Версия образа из ghcr.io: latest или точная, например sha-df56c40 (docker-compose.prod.yml)
# IMAGE_TAG=latest

# Домены отдельного фронтенда (React/Vue/Next.js), которым можно обращаться к API, через запятую:
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Пусто — только встроенный интерфейс /app. Виджет на сайтах-партнёрах работает в любом случае
CORS_ORIGINS=

# Домены, по которым открывают платформу (защита от подмены заголовка Host), через запятую.
# Например: ads.example.com. * — любые
ALLOWED_HOSTS=*

# Если перед платформой стоит nginx/балансировщик — его IP (или * во внутренней сети Docker),
# чтобы учитывался реальный IP посетителя. Без прокси оставьте 127.0.0.1
FORWARDED_ALLOW_IPS=127.0.0.1


# ------------------------------------------------------------------------------
# БАЗА ДАННЫХ (PostgreSQL)
# ------------------------------------------------------------------------------
# Пароль: только латиница, цифры, - и _ (он вставляется в адрес подключения).
# Не задан — mysecretpassword123: база наружу не открыта, но на сервере задайте свой
POSTGRES_PASSWORD=
# POSTGRES_USER=postgres
# POSTGRES_DB=ad_platform_db
# Пул подключений, SSL и адрес базы настраивать не нужно: база — в той же сети Docker


# ------------------------------------------------------------------------------
# БЕЗОПАСНОСТЬ И ВХОД (JWT)
# ------------------------------------------------------------------------------
# Ключ подписи токенов входа, не короче 32 символов. Смена ключа разлогинит всех.
# Не задан — приложение сгенерирует случайный и сохранит в томе с данными (не известный всем ключ)
SECRET_KEY=

# Сколько минут действует вход (токен). Обновления токена (refresh) нет — после истечения
# пользователь входит заново
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# Защита от перебора паролей и массовой регистрации
# LOGIN_MAX_FAILURES_PER_EMAIL=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_WINDOW_MINUTES=15
# REGISTER_MAX_PER_IP_PER_HOUR=10


# ------------------------------------------------------------------------------
# REDIS И ОЧЕРЕДЬ ЗАДАЧ (docker-compose.prod.yml)
# ------------------------------------------------------------------------------
# Redis доступен только внутри сети Docker (порт наружу не открыт), но пароль всё равно задайте свой.
# Не задан — myredispassword123
REDIS_PASSWORD=
# Сколько задач Celery-воркер выполняет одновременно
# CELERY_CONCURRENCY=2


# ------------------------------------------------------------------------------
# AI-ФУНКЦИИ (все необязательны: без ключа функция выключена, остальное работает)
# ------------------------------------------------------------------------------
# AI-подсказка модератору (Claude): console.anthropic.com → API Keys
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# Автоматически отклонять явные нарушения (reject + высокий риск). По умолчанию — только подсказка
# AI_AUTO_REJECT=false

# AI-копирайтер (Google Gemini): aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Цены модели, $ за 1 млн токенов (у 3.8 Flash с 01.01.2027 — 1.50 / 7.50)
# GEMINI_PRICE_INPUT_PER_1M=0.75
# GEMINI_PRICE_OUTPUT_PER_1M=3.75
# Наценка платформы к себестоимости и курс: сколько единиц валюты баланса стоит 1 $ (рубли — ~90)
# AI_MARKUP=1.5
# USD_RATE=1

# Бесплатная модерация текста (OpenAI Moderation API): platform.openai.com/api-keys
# OPENAI_API_KEY=

# Зависшие AI-задачи: как часто проверять (с) и через сколько минут задача считается зависшей (≥ 2)
# AI_CLEANUP_INTERVAL_SECONDS=300
# AI_TASK_TIMEOUT_MINUTES=10


# ------------------------------------------------------------------------------
# ОПЛАТА КЛИКОВ
# ------------------------------------------------------------------------------
# Повторный клик с того же IP по той же кампании в течение N минут не оплачивается
CLICK_DEDUP_MINUTES=10


# ------------------------------------------------------------------------------
# ДОМЕН И HTTPS (надстройка docker-compose.https.yml, Caddy + Let's Encrypt)
# ------------------------------------------------------------------------------
# DNS-запись домена должна указывать на этот сервер, порты 80 и 443 открыты
DOMAIN=
# Email для Let's Encrypt (уведомления о сертификате)
ACME_EMAIL=
# HTTP_PORT=80
# HTTPS_PORT=443


# ------------------------------------------------------------------------------
# МОНИТОРИНГ ОШИБОК (Sentry)
# ------------------------------------------------------------------------------
# sentry.io → проект (Python / FastAPI) → Settings → Client Keys (DSN). Пусто — выключено.
# Ошибки веб-сервера и Celery-воркера приходят оповещениями; личные данные и токены не отправляются
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Доля запросов с замером производительности: 0 — только ошибки, 0.1 — каждый десятый запрос
# SENTRY_TRACES_SAMPLE_RATE=0


# ------------------------------------------------------------------------------
# ПОКА НЕ ПОДДЕРЖИВАЕТСЯ
# ------------------------------------------------------------------------------
# Отправка почты (SMTP), файловое хранилище (S3), метрики (Prometheus), refresh-токены, Redis с TLS
# в приложении ещё не реализованы — переменные для них ни на что бы не влияли, поэтому их здесь нет.
# Логи — в стандартный вывод контейнеров: docker compose logs -f api
